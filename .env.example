# Copia este fichero a .env
# y rellena solo las claves que vayas a usar.

# LangSmith
# Ruta: https://smith.langchain.com/settings
API_KEY_LANGSMITH=

# OpenAI
# Ruta: https://platform.openai.com/api-keys
API_KEY_OPENAI=

# Langfuse (eval del mail_agent en langfuse/)
# Ruta: https://cloud.langfuse.com → Settings → API Keys
# BASE_URL: https://cloud.langfuse.com (o https://us.cloud.langfuse.com según la región)
API_KEY_PUBLIC_LANGFUSE=
API_KEY_PRIVATE_LANGFUSE=
BASE_URL_LANGFUSE=

# OpenCode Zen 
# Ruta: https://opencode.ai/auth
# API_KEY_OPENCODE_ZEN=

# Gemini
# Ruta: https://aistudio.google.com/api-keys
# API_KEY_GEMINI=

# DeepSeek
# Ruta: https://platform.deepseek.com/api_keys
# API_KEY_DEEPSEEK=

# Groq
# Ruta: https://console.groq.com/keys
# API_KEY_GROQ=
